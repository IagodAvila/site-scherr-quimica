{
  "name": "site-scherr-quimica",
  "version": "1.0.0",
  "description": "Website institucional da Scherr Química.",
  "private": true,
  "scripts": {
    "dev": "trap 'kill 0' EXIT INT TERM; tailwindcss -i ./src/input.css -o ./assets/app.css --watch=always & python3 -m http.server 8080",
    "serve": "python3 -m http.server 8080",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/app.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/app.css --watch",
    "build": "npm run build:css && python3 tools/gerar_paginas.py && npm run build:css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IagodAvila/site-scherr-quimica.git"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/IagodAvila/site-scherr-quimica/issues"
  },
  "homepage": "https://github.com/IagodAvila/site-scherr-quimica#readme",
  "devDependencies": {
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^3.4.19"
  }
}
